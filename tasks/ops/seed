#!/usr/bin/env bash
#MISE description="Seed the production database through the task Lambda function"
# Runs `hanami db seed` against the production RDS through the task Lambda function.
# Requires: aws CLI with AWS_PROFILE=terraform configured
set -euo pipefail

unset AWS_ENDPOINT_URL
export AWS_PROFILE=terraform
export AWS_REGION=ap-northeast-1

exec scripts/invoke-lambda-task '{"task":"db:seed"}'
