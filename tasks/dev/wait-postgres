#!/usr/bin/env bash
#MISE description="Wait until the RDS instance served by Floci accepts connections"
#MISE hide=true
# The instance is created by `terraform apply` and served by Floci, so the tasks that need it wait for it.
# pg_isready succeeds even when the database does not exist, so connect to it once the server is up
# and fail with a hint instead of letting the dependent tasks crash on the missing database.
set -euo pipefail

until pg_isready -h localhost -p 7001 -U pasta_atlas -q; do sleep 1; done

if ! psql "$DATABASE_URL" --quiet --command 'SELECT 1' >/dev/null; then
  echo "Cannot connect to the development database. Run 'mise run setup' to create it." >&2
  exit 1
fi
