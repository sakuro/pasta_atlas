#!/usr/bin/env bash
#MISE description="Wait until Floci serves the S3 cleanup queue"
#MISE hide=true
# Floci answers before it has loaded its stored queues, and the worker would get "queue does not exist".
set -euo pipefail

until aws sqs get-queue-attributes --queue-url "$SQS_S3_CLEANUP_QUEUE_URL" >/dev/null 2>&1; do sleep 1; done
