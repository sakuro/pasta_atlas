#!/usr/bin/env bash
#MISE description="Run terraform plan for an environment"
#MISE raw=true
#USAGE arg "<env>" help="local or production" {
#USAGE   choices "local" "production"
#USAGE }
set -euo pipefail

args=(terraform -chdir="terraform/$usage_env" plan)

if [ "$usage_env" = production ]; then
  # The development environment points the AWS CLI at Floci.
  unset AWS_ENDPOINT_URL
  export AWS_PROFILE=terraform
  workspace=$(fnox get PRODUCTION_TF_WORKSPACE)
  export TF_WORKSPACE="$workspace"
  # Secrets are resolved here instead of in mise.toml, where every shell prompt would wait for
  # 1Password.
  args=(fnox exec -- "${args[@]}")
fi

exec "${args[@]}"
