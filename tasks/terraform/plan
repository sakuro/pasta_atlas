#!/usr/bin/env bash
#MISE description="Run terraform plan for an environment"
#MISE raw=true
#USAGE arg "<env>" help="local or production" {
#USAGE   choices "local" "production"
#USAGE }
set -euo pipefail

if [ "$usage_env" = production ]; then
  # The development environment points the AWS CLI at Floci.
  unset AWS_ENDPOINT_URL
  export AWS_PROFILE=terraform
fi

exec terraform -chdir="terraform/$usage_env" plan
