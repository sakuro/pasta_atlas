{
  "name": "pasta_atlas",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "vite build",
    "dev:frontend": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint:frontend": "find frontend -path frontend/lib/api/gen -prune -o \\( -name '*.ts' -o -name '*.tsx' \\) -print | xargs -r eslint",
    "format:frontend": "prettier --write \"frontend/**/*.{ts,tsx}\"",
    "generate:api": "openapi-ts && prettier --write frontend/lib/api/gen",
    "test:frontend": "vitest"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "@fluent/dom": "^0.10.2",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@solidjs/router": "^2.0.1",
    "@solidjs/web": "^2.0.3",
    "bulma": "^1.0.4",
    "esbuild": "^0.28.1",
    "hanami-assets": "^3.0.0",
    "leaflet": "^1.9.4",
    "solid-js": "^2.0.3",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.0.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.0.0",
    "eslint-plugin-solid": "^0.20.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
