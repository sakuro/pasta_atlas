{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Node.js is pinned in mise.toml and in every workflow; update them together.",
      "matchPackageNames": ["node"],
      "matchDatasources": ["node-version"],
      "groupName": "Node.js"
    },
    {
      "description": "Packages of the Solid monorepo are released in lockstep and @solidjs/web peer-depends on the same solid-js patch version.",
      "matchSourceUrls": ["https://github.com/solidjs/solid"],
      "groupName": "Solid"
    },
    {
      "description": "git-hooks is our own package, so its releases need no waiting period.",
      "matchPackageNames": ["sakuro/git-hooks"],
      "minimumReleaseAge": null
    },
    {
      "description": "hk.pkl amends the Config.pkl and imports the Builtins.pkl of a specific hk release; keep them on the hk version in mise.toml.",
      "matchDepNames": ["hk"],
      "groupName": "hk"
    },
    {
      "description": "The Lambda runtime in Terraform must change together with the build image minor version.",
      "matchPackageNames": ["public.ecr.aws/lambda/ruby"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "mise resolves postgres to conda:postgresql on conda-forge, but Renovate looks it up without the channel.",
      "matchManagers": ["mise"],
      "matchDatasources": ["conda"],
      "matchPackageNames": ["postgresql"],
      "overridePackageName": "conda-forge/postgresql"
    },
    {
      "description": "The PostgreSQL major version follows the production RDS engine_version (Terraform); update CI, compose.yml, mise.toml and RDS together.",
      "matchDatasources": ["docker", "conda"],
      "matchPackageNames": ["postgres", "postgresql", "conda-forge/postgresql"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>[^/]+)/hk@[^#\"]+"
      ],
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/sakuro/git-hooks/releases/download/v(?<currentValue>[^/]+)/git-hooks@[^#\"]+"
      ],
      "autoReplaceStringTemplate": "package://github.com/sakuro/git-hooks/releases/download/v{{{newValue}}}/git-hooks@{{{newValue}}}",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sakuro/git-hooks",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  }
}
