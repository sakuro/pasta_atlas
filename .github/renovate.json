{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Node.js is pinned in mise.toml and in every workflow; update them together.",
      "matchPackageNames": ["node"],
      "matchDatasources": ["node-version"],
      "groupName": "Node.js"
    },
    {
      "description": "The Lambda runtime in Terraform must change together with the build image minor version.",
      "matchPackageNames": ["public.ecr.aws/lambda/ruby"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "The PostgreSQL major version follows the production RDS engine_version (Terraform); update CI, compose.yml and RDS together.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  }
}
